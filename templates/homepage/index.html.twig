    {% extends 'base.html.twig' %}

    {% block title %}Homepage | Growfico{% endblock %}

    {% block body %}
    <link rel="stylesheet" href="{{asset('styles/homepage.css')}}">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
     <main class="main">   
       <section class="hero">
        <div class="container">
            <div class="hero-content">
                <h1 class="hero-title">
                    Cultivate <span class="highlight">Thriving Gardens</span> <br>
                    with Expert Guidance
                </h1>
                <p class="hero-description">
                    Transform your space into a productive paradise. Learn essential growing techniques 
                    like grafting, air layering, and budding while getting premium seedlings and fresh fruits. 
                    Perfect for beginners and experienced growers alike.
                </p>
                
                <div class="cta-buttons" style="margin-top:2rem; margin-bottom:2rem; gap:2rem;">
                    <a href="#about" class="btn-secondary" style="border-radius:8px;font-size:1rem; padding:1rem 2.2rem; display:flex; align-items:center; gap:0.5rem; background:linear-gradient(90deg,#e8f5e9,#f7fafc); color:var(--color-dark-forest-green); border:1.5px solid var(--color-bright-green);">
                        <ion-icon name="leaf-outline" style="font-size:1.3rem;"></ion-icon>
                        <span>Learn Our Methods</span>
                        <svg class="arrow-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                    </a>
                </div>

                <div class="hero-stats">
                    <div class="stat">
                        <span class="stat-number">500+</span>
                        <span class="stat-label">Transformed</span>
                    </div>
                    <div class="stat">
                        <span class="stat-number">15+</span>
                        <span class="stat-label">Techniques</span>
                    </div>
                    <div class="stat">
                        <span class="stat-number">98%</span>
                        <span class="stat-label">Success Rate</span>
                    </div>
                </div>
            </div>
            
            <div class="hero-image">
                <img src="{{ asset('gardens/garden3.png') }}" alt="Thriving Garden" />
            </div>
        </div>
    </section>
    </main>

    {% endblock %}
