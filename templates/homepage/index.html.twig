                        <svg class="star active" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd" fill-rule="evenodd" />
                        </svg>
                        <svg class="star active" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd" fill-rule="evenodd" />
                        </svg>
                        <svg class="star inactive" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd" fill-rule="evenodd" />
                        </svg>
                    </div>
                    <p class="sr-only">4 out of 5 stars</p>
                    <a href="#" class="reviews-link">117 reviews</a>
                </div>
                    <!-- Sizes -->
                    <div class="form-section">
                        <div class="size-header">
                            <label class="form-label">Size</label>
                            <a href="#" class="size-guide">Size guide</a>
                        </div>
                        <fieldset aria-label="Choose a size">
                            <div class="size-grid">
                                <label class="size-option" aria-label="XXS">
                                    <input type="radio" name="size" disabled class="size-input" />
                                    <span class="size-label">XXS</span>
                                </label>
                                <label class="size-option" aria-label="XS">
                                    <input type="radio" name="size" class="size-input" />
                                    <span class="size-label">XS</span>
                                </label>
                                <label class="size-option" aria-label="S">
                                    <input type="radio" name="size" checked class="size-input" />
                                    <span class="size-label">S</span>
                                </label>
                                <label class="size-option" aria-label="M">
                                    <input type="radio" name="size" class="size-input" />
                                    <span class="size-label">M</span>
                                </label>
                                <label class="size-option" aria-label="L">
                                    <input type="radio" name="size" class="size-input" />
                                    <span class="size-label">L</span>
                                </label>
                                <label class="size-option" aria-label="XL">
                                    <input type="radio" name="size" class="size-input" />
                                    <span class="size-label">XL</span>
                                </label>
                                <label class="size-option" aria-label="2XL">
                                    <input type="radio" name="size" class="size-input" />
                                    <span class="size-label">2XL</span>
                                </label>
                                <label class="size-option" aria-label="3XL">
                                    <input type="radio" name="size" class="size-input" />
                                    <span class="size-label">3XL</span>
                                </label>
                            </div>
                        </fieldset>
                    </div>

                    <button type="submit" class="add-to-bag">Add to bag</button>
                </form>
            </div>
        </div>
    </div>
</body>


{% endblock %}
